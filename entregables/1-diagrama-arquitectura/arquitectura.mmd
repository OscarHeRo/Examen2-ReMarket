%% ============================================================================
%% ReMarket — Arquitectura Cloud Segura (Criptografía y Seguridad 2027-1)
%% Diseño de referencia en AWS y componentes Cloud-Native / Zero Trust
%% ============================================================================
flowchart TB

    subgraph Z0["ZONA NO CONFIABLE — Internet Pública"]
        U["Cliente Web / Móvil"]
        OP["Personal Interno / Admin"]
    end

    subgraph Z1["ZONA PERIMETRAL (DMZ) — Filtrado e Ingress"]
        CDN["Amazon CloudFront<br/>(CDN + TLS 1.3 Termination)"]
        WAF["AWS WAF + AWS Shield<br/>(Anti-DDoS, Rate Limiting, OWASP Top 10)"]
        ALB["Application Load Balancer (ALB)<br/>(Terminación TLS / Balanceo L7)"]
        FE["Frontend Web (SPA estática en S3)"]
        GW["API Gateway / Envoy Ingress<br/>(Autenticación de tokens, Rate-Limit)"]
        VPN["AWS Client VPN + MFA<br/>(Acceso administrativo)"]
    end

    subgraph Z2["ZONA DE APLICACIÓN — Red Privada (Amazon EKS + Istio Service Mesh)"]
        AUTH["Microservicio Auth y Usuarios<br/>(Argon2id, Emisión JWT/OIDC)"]
        CAT["Microservicio Catálogo<br/>(Lectura intensiva)"]
        PED["Microservicio Pedidos<br/>(Orquestador de órdenes)"]
        INV["Microservicio Inventario<br/>(Control de stock transaccional)"]
        PAY["Microservicio Pagos<br/>(Integración tokenizada y webhooks)"]
        NOT["Microservicio Notificaciones<br/>(Consumidor de eventos)"]
        BUS[["Bus de Eventos / Cola<br/>(Amazon SQS / Kafka con SSE-KMS)"]]
        CACHE[("Amazon ElastiCache Redis<br/>(Caché de sesiones y catálogo encriptada)")]
    end

    subgraph Z3["ZONA DE DATOS — Subredes Aisladas sin Salida a Internet"]
        DBU[("Amazon RDS PostgreSQL<br/>(BD Usuarios — AES-256-GCM)")]
        DBT[("Amazon RDS PostgreSQL Multi-AZ<br/>(BD Transaccional — Pedidos y Stock)")]
        DBC[("Amazon DynamoDB / S3<br/>(Catálogo y multimedia)")]
        LOG[("Amazon S3 Object Lock (WORM)<br/>(Logs inmutables de auditoría)")]
    end

    subgraph Z4["SERVICIOS DE SEGURIDAD Y GOBERNANZA"]
        KMS["AWS KMS / CloudHSM (FIPS 140-2 L3)<br/>(Custodia de KEKs y firmas)"]
        SEC["AWS Secrets Manager<br/>(Credenciales y rotación de secrets)"]
        IAM["AWS IAM + IRSA / SPIFFE-SPIRE<br/>(Identidades x509 efímeras y RBAC)"]
        SIEM["Amazon OpenSearch / SIEM<br/>(Detección de anomalías en tiempo real)"]
    end

    subgraph Z5["TERCEROS CONFIABLES (APIs Externas)"]
        PSP["Pasarela de Pagos (Stripe)<br/>(Tokenización PCI-DSS SAQ-A)"]
        SHIP["API Paquetería / Envíos<br/>(DHL / FedEx / Estafeta)"]
        MSG["Proveedor Notificaciones<br/>(Twilio SMS / Amazon SES)"]
    end

    %% --- Flujo de Entrada de Usuarios ---
    U -->|"HTTPS (TLS 1.3, ECDHE-X25519, HSTS)"| CDN
    CDN -->|"Inspección de tráfico L7"| WAF
    WAF --> ALB
    ALB -->|"Carga estática"| FE
    ALB -->|"HTTPS + JWT Bearer"| GW
    OP -->|"Túnel TLS / WireGuard + MFA"| VPN
    VPN -->|"Acceso mTLS restringido"| GW

    %% --- Pasarela hacia Microservicios ---
    GW -->|"mTLS (Envoy sidecars / SPIFFE x509) + JWT"| AUTH
    GW -->|"mTLS + JWT"| CAT
    GW -->|"mTLS + JWT"| PED
    GW -->|"mTLS + JWT"| INV
    GW -->|"mTLS + JWT"| PAY

    %% --- Comunicación Interna Este-Oeste ---
    PED -->|"mTLS (Zero Trust) + JWT contexto"| INV
    PED -->|"mTLS + JWT contexto"| PAY
    CAT -->|"TLS + Auth Redis"| CACHE

    %% --- Mensajería Asíncrona Confiable ---
    PED -.->|"Evento firmado (ECDSA P-256 en KMS) vía TLS"| BUS
    BUS -.->|"Lectura autenticada (IAM IRSA / TLS 1.3)"| NOT
    BUS -.->|"Consumo y actualización stock"| INV

    %% --- Acceso a Capa de Datos (Mínimo Privilegio) ---
    AUTH -->|"TLS 1.3 + IAM (IRSA) / KMS"| DBU
    PED -->|"TLS 1.3 + IAM (IRSA) / KMS"| DBT
    PAY -->|"TLS 1.3 + IAM (IRSA) / KMS"| DBT
    INV -->|"TLS 1.3 + IAM (IRSA) / KMS"| DBT
    CAT -->|"HTTPS con SigV4"| DBC
    AUTH -.->|"Syslog TLS"| LOG
    PED -.->|"Syslog TLS"| LOG
    PAY -.->|"Syslog TLS"| LOG

    %% --- Integración de Gobernanza y Criptografía ---
    KMS -.->|"Envelope Encryption (DEK/KEK)"| DBU
    KMS -.->|"Envelope Encryption (DEK/KEK)"| DBT
    KMS -.->|"Claves para firmas de facturas"| PED
    SEC -.->|"Inyección en runtime (External Secrets)"| AUTH
    SEC -.->|"Shared secret webhook"| PAY
    IAM -.->|"Tokens temporales STS / IRSA"| GW
    LOG -.-> SIEM

    %% --- Salidas y Entradas con Terceros ---
    U -.->|"Tokenización directa (Frontend SDK)<br/>ReMarket NUNCA toca PAN/CVV"| PSP
    PAY <-->|"HTTPS (TLS 1.3) + Webhook firmado HMAC-SHA256"| PSP
    PED -->|"HTTPS (TLS 1.3) + API Key rotada"| SHIP
    NOT -->|"HTTPS (TLS 1.3) + Autenticación IAM"| MSG

    %% --- Estilos de Zonas de Confianza ---
    classDef noconf fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#000
    classDef dmz    fill:#fff8e1,stroke:#f57f17,stroke-width:2px,color:#000
    classDef app    fill:#e1f5fe,stroke:#0277bd,stroke-width:2px,color:#000
    classDef datos  fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
    classDef segur  fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#000
    classDef terc   fill:#eceff1,stroke:#455a64,stroke-width:2px,stroke-dasharray:5 4,color:#000

    class U,OP noconf
    class CDN,WAF,ALB,FE,GW,VPN dmz
    class AUTH,CAT,PED,INV,PAY,NOT,BUS,CACHE app
    class DBU,DBT,DBC,LOG datos
    class KMS,SEC,IAM,SIEM segur
    class PSP,SHIP,MSG terc
