%% ============================================================================
%% ReMarket — Arquitectura cloud segura (BORRADOR / ESQUELETO)
%%
%% Esto es un PUNTO DE PARTIDA, no la respuesta. Contiene los 14 componentes
%% mínimos que exige el examen y una propuesta de zonas de confianza.
%% El equipo debe revisarlo, discutirlo, corregirlo y justificarlo.
%%
%% Vista previa: https://mermaid.live
%% ============================================================================
flowchart TB

    subgraph Z0["🌐 ZONA NO CONFIABLE — Internet"]
        U["👤 Usuario / Cliente"]
        OP["👤 Personal interno"]
    end

    subgraph Z1["🛡️ ZONA PERIMETRAL — DMZ"]
        CDN["CDN"]
        WAF["WAF + Anti-DDoS"]
        LB["Balanceador de carga"]
        FE["Frontend web"]
        GW["API Gateway"]
    end

    subgraph Z2["🔒 ZONA DE APLICACIÓN — red privada"]
        AUTH["Auth y Usuarios"]
        CAT["Catálogo"]
        PED["Pedidos"]
        INV["Inventario"]
        PAY["Pagos"]
        NOT["Notificaciones"]
        BUS[["Cola / Bus de eventos"]]
        CACHE[("Caché")]
    end

    subgraph Z3["🔐 ZONA DE DATOS — sin salida a Internet"]
        DBU[("BD Usuarios")]
        DBT[("BD Transaccional - pedidos y pagos")]
        DBC[("Almacenamiento Catálogo")]
        LOG[("Registros de auditoría")]
    end

    subgraph Z4["🔑 SERVICIOS DE SEGURIDAD"]
        KMS["KMS / HSM"]
        SEC["Secret Manager"]
        IAM["IAM / Cuentas de servicio"]
        SIEM["SIEM / Monitoreo"]
    end

    subgraph Z5["🌍 TERCEROS — fuera de nuestro control"]
        PSP["Pasarela de pagos"]
        SHIP["Paquetería"]
        MSG["Proveedor Correo / SMS"]
    end

    %% --- Entrada del usuario ---
    U -->|"HTTPS / TLS 1.3"| CDN
    CDN --> WAF
    WAF --> LB
    LB --> FE
    FE -->|"HTTPS + token de sesión"| GW
    OP -->|"VPN + MFA"| GW

    %% --- Gateway hacia microservicios ---
    GW -->|"mTLS"| AUTH
    GW -->|"mTLS"| CAT
    GW -->|"mTLS"| PED
    GW -->|"mTLS"| INV
    GW -->|"mTLS"| PAY

    %% --- Entre microservicios ---
    PED -->|"mTLS + token"| INV
    PED -->|"mTLS + token"| PAY
    CAT --> CACHE

    %% --- Eventos asíncronos ---
    PED -.->|"evento firmado"| BUS
    BUS -.->|"evento firmado"| NOT
    BUS -.->|"evento firmado"| INV

    %% --- Acceso a datos: cada servicio SOLO a lo suyo ---
    AUTH -->|"TLS + cifrado en reposo"| DBU
    PED -->|"TLS + cifrado en reposo"| DBT
    PAY -->|"TLS + cifrado en reposo"| DBT
    INV --> DBT
    CAT --> DBC
    AUTH --> LOG
    PED --> LOG
    PAY --> LOG

    %% --- Servicios de seguridad ---
    KMS -.->|"claves de cifrado"| DBU
    KMS -.->|"claves de cifrado"| DBT
    SEC -.->|"secretos en runtime"| AUTH
    SEC -.->|"secretos en runtime"| PAY
    IAM -.->|"autorización"| GW
    LOG -.-> SIEM

    %% --- Terceros ---
    U -->|"datos de tarjeta NUNCA pasan por ReMarket"| PSP
    PAY <-->|"TLS + webhook firmado"| PSP
    PED -->|"TLS + API key rotada"| SHIP
    NOT -->|"TLS"| MSG

    %% --- Estilos por zona ---
    classDef noconf fill:#ffe5e5,stroke:#c0392b,stroke-width:2px,color:#000
    classDef dmz    fill:#fff4e0,stroke:#e67e22,stroke-width:2px,color:#000
    classDef app    fill:#e8f4fd,stroke:#2980b9,stroke-width:2px,color:#000
    classDef datos  fill:#e8f8f0,stroke:#27ae60,stroke-width:2px,color:#000
    classDef segur  fill:#f0e8fd,stroke:#8e44ad,stroke-width:2px,color:#000
    classDef terc   fill:#eeeeee,stroke:#7f8c8d,stroke-width:2px,stroke-dasharray:5 3,color:#000

    class U,OP noconf
    class CDN,WAF,LB,FE,GW dmz
    class AUTH,CAT,PED,INV,PAY,NOT,BUS,CACHE app
    class DBU,DBT,DBC,LOG datos
    class KMS,SEC,IAM,SIEM segur
    class PSP,SHIP,MSG terc
